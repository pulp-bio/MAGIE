# Adapted from:
# https://github.com/github/gitignore/blob/master/KiCad.gitignore

# For PCBs designed using KiCad: http://www.kicad-pcb.org/
# Format documentation: http://kicad-pcb.org/help/file-formats/

# Custom
*backup*
*~*
*auto_saved*
pdf_exports
*.step
*.STEP
*.stp
.history/
# Archives (e.g. KiCad project archives); release packages are re-included below
*.zip

# Vendor 3D models: download locally, never commit (see each board's 3d_vendor/README.md)
hw/baseboard/hw/3d_vendor/*
!hw/baseboard/hw/3d_vendor/README.md
hw/*/3d_vendor/*
!hw/*/3d_vendor/README.md

# Production: only the released package generated by hw/baseboard/hw/jobset.kicad_jobset
hw/baseboard/production/*
!hw/baseboard/production/MAGIE_baseboard/
!hw/baseboard/production/MAGIE_baseboard_fabrication.zip

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_prl
*.lck
*.sch-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
.DS-Store
generated
/build

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Footprint association file (exported from Pcbnew)
*.cmp

# Exported BOM files
*.xml
*.csv
*.tsv
!hw/baseboard/production/MAGIE_baseboard/**/*.csv

# Misc
*.log
*.raw
.svg2shenzhen-cache
